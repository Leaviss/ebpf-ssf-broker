      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (max_over_time(zta_revocation_pipeline_seconds_bucket[$__range])) - sum by (le) (min_over_time(zta_revocation_pipeline_seconds_bucket[$__range])))",
          "instant": true,
          "range": false,
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
