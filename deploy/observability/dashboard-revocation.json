        },
        {
          "type": "timeseries",
          "id": 32,
          "title": "T7 \u2014 proxy convergence p95 (istiod-side)",
          "description": "push \u2192 proxy ACK as istiod sees it. Its smallest bucket is 100ms, so treat it as a coarse 'did convergence blow up' check; the reported enforce span is T8 \u2212 T6 from the \u00a76 CSV.",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
