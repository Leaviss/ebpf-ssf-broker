    {
      "type": "row",
      "id": 30,
      "title": "Diagnostics \u2014 T7 (istiod) + process restarts. Not part of the reported result.",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "collapsed": true,
      "panels": [
        {
          "type": "timeseries",
