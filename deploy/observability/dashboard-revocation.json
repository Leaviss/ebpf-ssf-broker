    {
      "type": "bargauge",
      "id": 11,
      "title": "mean per stage (exact)",
      "description": "Where the pipeline's time goes, as means of the real observations rather than bucket estimates. `enforce` (T8\u2212T6) is absent by construction \u2014 it needs T8 from the prober and is joined offline (\u00a76). Counted as a delta over the dashboard range (max_over_time - min_over_time), not the counter's lifetime total: the actuator outlives the run, so its counters accumulate across every trial. The delta is exact \u2014 no increase() extrapolation \u2014 and survives a restart, but it needs the range to start before the first trial. If the 'actuator restart' annotation fires inside the range, check that count against the CSV.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (stage) (max_over_time(zta_revocation_stage_seconds_sum[$__range])) - sum by (stage) (min_over_time(zta_revocation_stage_seconds_sum[$__range]))) / (sum by (stage) (max_over_time(zta_revocation_stage_seconds_count[$__range])) - sum by (stage) (min_over_time(zta_revocation_stage_seconds_count[$__range])))",
          "instant": true,
          "range": false,
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "no trials in range"
